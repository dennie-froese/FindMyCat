{
  "name": "mobile",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "^58.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "npm run test:typecheck && npm run test:unit && npm run test:sim",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/privacyEngine.test.mjs tests/monetization.test.mjs tests/multiPet.test.mjs tests/onboarding.test.mjs tests/ratingFlow.test.mjs",
    "test:sim": "bash scripts/test-simulator.sh",
    "build:ios:sim": "eas build --platform ios --profile preview-simulator",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production"
  },
  "private": true
}
